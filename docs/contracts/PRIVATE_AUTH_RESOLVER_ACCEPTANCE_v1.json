  "decisions": [
    {
      "id": "D1",
      "status": "owner_decision_required",
      "subject": "authenticated private IPC consumer; operation-name conflict review",
      "alternatives": [
        {
          "id": "A",
          "choice": "Linux registered-peer Unix-domain IPC"
        },
        {
          "id": "B",
          "choice": "supervisor inherited socketpair/FD"
        },
        {
          "id": "C",
          "choice": "loopback bearer HTTP"
        }
      ],
      "recommended_alternative": "A",
      "source_seams": [
        "S1",
        "S7"
      ],
      "security_tradeoffs": "Linux-only bounded boundary; no UID-only actor mapping; explicit registration and restart fencing burden",
      "admission_prerequisites": "exact dispatcher/schema/enums/registration owner and malformed/resource/peer fixtures",
      "promotion_owner": "Sir V3",
      "promotion_evidence": null
    },
    {
      "id": "D2",
      "status": "owner_decision_required",
      "subject": "exact Focusa authority verifier/reserve/consume/reconcile operations, trust and IR5 admission",
      "alternatives": [
        {
          "id": "A",
          "choice": "external durable ledger plus local recovery journal"
        },
        {
          "id": "B",
          "choice": "distributed two-phase commit"
        },
        {
          "id": "C",
          "choice": "local mutex and best-effort receipt"
        }
      ],
      "recommended_alternative": "A",
      "source_seams": [
        "S1",
        "S7"
      ],
      "security_tradeoffs": "no distributed atomicity or exactly-once login; conservative possible_use and lower availability",
      "admission_prerequisites": "pinned Focusa operations/trust/schema, revocation linearization/window, crash fixtures and reaper",
      "promotion_owner": "Sir V3",
      "promotion_evidence": null
    },
    {
      "id": "D3",
      "status": "owner_decision_required",
      "subject": "private context allocation and provider-specific fresh account verifier",
      "alternatives": [
        {
          "id": "A",
          "choice": "dedicated private Incognito context"
        },
        {
          "id": "B",
          "choice": "dedicated ephemeral profile/process"
        },
        {
          "id": "C",
          "choice": "reuse operator profile or pooled page"
        }
      ],
      "recommended_alternative": "B",
      "source_seams": [
        "S2",
        "S3",
        "S4",
        "S5",
        "S6"
      ],
      "security_tradeoffs": "more process memory/startup cost; process isolation alone does not prove capture or egress safety",
      "admission_prerequisites": "exact lifecycle/capacity/cleanup, documented trusted provider account endpoint and tenant/freshness contract",
      "promotion_owner": "Sir V3",
      "promotion_evidence": null
    }
  ],
