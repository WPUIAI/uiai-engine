  ],
  "runtime_cases": [
    {
      "id": "PA01",
      "category": "positive_real_browser",
      "status": "required_not_executed",
      "required_assertion": "Admitted private dispatcher authenticates synthetic fixture; fresh account endpoint matches trusted expected account; challenge resumes once; ordinary ops remain denied until authorized resume."
    },
    {
      "id": "PA02",
      "category": "stale_replay",
      "status": "required_not_executed",
      "required_assertion": "Expired grant, old revision, old context/challenge/frame generation and consumed idempotency key cannot cause another retrieval/submit."
    },
    {
      "id": "PA03",
      "category": "origin_change",
      "status": "required_not_executed",
      "required_assertion": "Wrong origin, hostile form.action, cross-origin frame, redirect or navigation race denies before next secret use; no exfiltration."
    },
    {
      "id": "PA04",
      "category": "account_mismatch",
      "status": "required_not_executed",
      "required_assertion": "Expected account from trusted binding differs from fresh authenticated account; no resume even after HTTP200/submit success."
    },
    {
      "id": "PA05",
      "category": "grant_rejection",
      "status": "required_not_executed",
      "required_assertion": "Absent/untrusted/malformed/revoked/wrong-actor/scope/operation/consumer/effect/use-limit grants reject before custodian call; revocation during execution prevents resume."
    },
    {
      "id": "PA06",
      "category": "no_secret_leak",
      "status": "required_not_executed",
      "required_assertion": "Synthetic secret and encoded/decoded aliases absent from all model outputs, responses, logs, events, diagnostics, receipts, argv and persisted artifacts; no screenshot/stream/recorder capture while quarantined."
    },
    {
      "id": "PA07",
      "category": "ordinary_guard",
      "status": "required_not_executed",
      "required_assertion": "Ordinary fill/eval/eval_async/click and public FPV control remain denied; no resume through caller-supplied boolean/token/JS."
    },
    {
      "id": "PA08",
      "category": "private_context_isolation",
      "status": "required_not_executed",
      "required_assertion": "Private/private and pooled/private cookie/storage separation; pooled session refuses provider use before retrieval; separate private capacity accounting."
    },
    {
      "id": "PA09",
      "category": "fence_concurrency",
      "status": "required_not_executed",
      "required_assertion": "Parallel request/resume/cancel/close/navigation races have one winner; exact current challenge/account/context verified atomically at resume. Enumerate public-resolve interleavings R1-R8 against actual legacy route and private fence."
    },
    {
      "id": "PA10",
      "category": "ambiguous_side_effect",
      "status": "required_not_executed",
      "required_assertion": "Lost response or timeout after submit reconciles same immutable idempotency binding without a second retrieval or submit; uncertain use is never reported unused. Enumerate distributed windows W1-W7; no distributed atomicity claim."
    },
    {
      "id": "PA11",
      "category": "renewability",
      "status": "required_not_executed",
      "required_assertion": "Recovery/break-glass/unknown-renewability and unsupported challenge classes stop before provider access; trusted-clock TOTP window constraints tested."
    },
    {
      "id": "PA12",
      "category": "cleanup_crash",
      "status": "required_not_executed",
      "required_assertion": "Close/expiry/crash cancel owned context only; resource-specific cleanup receipts are idempotent; unverified residue keeps quarantine/incident."
    },
    {
      "id": "PA13",
      "category": "capture_quarantine_race",
      "status": "required_not_executed",
      "required_assertion": "Existing GET/read/snapshot/stream/share/export/recorder consumers cannot capture between admission, injection, identity verification and cleanup; failure never reopens captures. Cover inventory C1-C6/E1-E3, drain existing buffers/callbacks and hostile same-origin network exfiltration."
    },
    {
      "id": "PA14",
      "category": "authority_interoperability",
      "status": "required_not_executed",
      "required_assertion": "Pinned Focusa authority adapter performs actual current grant verification plus atomic reserve/consume/reconcile/revocation; test-only issuer impossible in release wiring."
    },
    {
      "id": "PA15",
      "category": "compatibility_installed",
      "status": "required_not_executed",
      "required_assertion": "Preserve ordinary formatting/lifecycle/privacy regressions; exact candidate binary and installed workers tested separately before real operator-site acceptance."
    }
  ],
