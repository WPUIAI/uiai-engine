{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "focusa.cockpit.bundle_manifest.v1",
  "title": "Cockpit Bundle Manifest",
  "type": "object",
  "required": ["schema","version","built_at","source_commit","artifacts"],
  "properties": {
    "schema": {"const": "focusa.cockpit.bundle_manifest.v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-dev)?$"},
    "built_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name","sha256","size"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
