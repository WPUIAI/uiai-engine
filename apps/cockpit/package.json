{
  "name": "uaiengine-cockpit",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "UIAI Engine Cockpit — Svelte/Tauri developer/operator desktop client (Slice 0).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run test && npm run cockpit:smoke -- --mode local-only --mock-external && vite build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test": "vitest run",
    "cockpit:smoke": "tsx smoke/smoke-runner.ts",
    "cockpit:gate": "npm run check && npm run build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.2.1",
    "@types/three": "^0.185.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "three": "^0.160.0"
  }
}
