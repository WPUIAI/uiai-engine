#!/usr/bin/env bash
# Compatibility entry point; the root Python owner writes every version surface.
set -euo pipefail
COCKPIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REPO_ROOT="$(cd "$COCKPIT_ROOT/../.." && pwd)"
if [[ "${APPS_COCKPIT:-$COCKPIT_ROOT}" != "$COCKPIT_ROOT" ]]; then
  echo 'Use the version owner inside the intended repository; external stamp roots are unsupported' >&2
  exit 2
fi
VERSION="${1:-}"
if [[ -z "$VERSION" ]]; then
  VERSION=$(grep -m1 '^version = ' "$COCKPIT_ROOT/src-tauri/Cargo.toml" | sed -E 's/version = "([^"]+)"/\1/')
fi
exec python3 "$REPO_ROOT/scripts/stamp-uiai-version.py" "cockpit-v${VERSION}" --cockpit-only
