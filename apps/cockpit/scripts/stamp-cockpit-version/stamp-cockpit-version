#!/usr/bin/env bash
# stamp-cockpit-version — sibling of Focusa scripts/stamp-release-version.
# Stamps the current version into apps/cockpit/src/lib/version.ts
# and apps/cockpit/src-tauri/tauri.conf.json.

set -euo pipefail
COCKPIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
APPS_COCKPIT="${APPS_COCKPIT:-$COCKPIT_ROOT}"
VERSION="${1:-}"
if [[ -z "$VERSION" ]]; then
  VERSION=$(grep -m1 '^version = ' "$APPS_COCKPIT/src-tauri/Cargo.toml" | sed -E 's/version = "([^"]+)"/\1/')
fi
if [[ -z "$VERSION" ]]; then
  echo "version not found" >&2
  exit 1
fi

mkdir -p "$APPS_COCKPIT/src/lib"
cat > "$APPS_COCKPIT/src/lib/version.ts" <<TS
// Generated by scripts/stamp-cockpit-version. Do not edit by hand.
export const APP_VERSION = "${VERSION}";
export const APP_CHANNEL = "${VERSION##*-}";
export const APP_RELEASE_TAG = "cockpit-v${VERSION}";
TS

TAURI_CONF="$APPS_COCKPIT/src-tauri/tauri.conf.json"
if [ -f "$TAURI_CONF" ]; then
  python3 - "$TAURI_CONF" "$VERSION" <<'PY'
import json, sys
path, version = sys.argv[1], sys.argv[2]
with open(path) as f:
    cfg = json.load(f)
if cfg.get("version") != version:
    cfg["version"] = version
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    print(f"updated tauri.conf.json to {version}")
else:
    print(f"tauri.conf.json already at {version}")
PY
fi

echo "stamped release version: $VERSION"
