{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uiai.client_ref.v1",
  "title": "ClientRef",
  "type": "object",
  "required": ["client_type", "client_id"],
  "properties": {
    "client_type": { "type": "string", "enum": ["pi", "cockpit", "menubar", "api", "mcp", "cli"] },
    "client_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" }
  },
  "additionalProperties": false
}
