#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENGINE_URL="${UIAI_ENGINE_URL:-http://localhost:7456}"
TIMEOUT_SECONDS="${UIAI_CLI_TIMEOUT_SECONDS:-${UIAI_SMOKE_TIMEOUT_SECONDS:-20}}"
FORMAT="compact"
AUTH_ARGS=()
if [[ -n "${UIAI_API_KEY:-}" ]]; then
  AUTH_ARGS=(-H "X-API-Key: ${UIAI_API_KEY}")
elif [[ -n "${UIAI_BEARER_TOKEN:-}" ]]; then
  AUTH_ARGS=(-H "Authorization: Bearer ${UIAI_BEARER_TOKEN}")
fi

usage() {
  cat <<'EOF'
UIAI CLI wrapper

Usage:
  scripts/uiai [--json|--compact|--pretty] <command> [args]

Commands:
  status                         Show engine runtime status
  health                         Show browser/vision health
  errors [opts]                  Show recent engine/browser errors
    --limit N                    Recent error limit (default 20)
    --source SOURCE              Filter source: http, panic, browser_session
    --class CLASS                Filter error class
  tools                          List tool names/descriptions
  tools search <query>           Search tool discovery
  tools mcp|openai|graph|agent-card|docs
  packet compose <json-file|->    Compose Focusa research diagnostics packet
  markdown <url> [--selector S] [--max-chars N] [--mode main_content|full] [--format json|markdown|jsonl] [--include-images]
                                  One-shot public URL to uiai.source_markdown.v1
  research packet [--query Q|--url URL] [--goal G] [--out PATH]
                                  One-command search/open/read/diagnose/packet/cleanup proof
  session open <url> [--width N] [--height N]
  session read <sid> [--selector S] [--max-chars N] [--format text|markdown] [--mode main_content|full]
  session snapshot <sid>
  session diagnostics <sid> [--limit N] [--failed-only]
  session close <sid>
  smoke agent                    Run scripts/smoke-agent-integrations.sh
  smoke browser                  Run scripts/stress-browser-diagnostics.sh
  smoke packet                   Run scripts/smoke-focusa-packet.sh
  install-agent-integrations     Run scripts/install-agent-integrations.sh

Output:
  --compact (default), --json, --pretty

Environment:
  UIAI_ENGINE_URL                Default: http://localhost:7456
  UIAI_API_KEY                   Optional X-API-Key auth for remote/auth routes
  UIAI_BEARER_TOKEN              Optional bearer auth alternative
  UIAI_CLI_TIMEOUT_SECONDS       Default: UIAI_SMOKE_TIMEOUT_SECONDS or 20

Exit codes:
  0 success, 1 API/tool failure, 2 usage error, 3 dependency missing, 4 auth/config error
EOF
}

err() { printf 'uiai: %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || { err "missing required command: $1"; exit 3; }; }
need curl
need jq

api() {
  local method="$1" path="$2" body="${3:-}"
  local args=(-sS --max-time "$TIMEOUT_SECONDS" -X "$method" "${AUTH_ARGS[@]}" "$ENGINE_URL$path")
  if [[ -n "$body" ]]; then
    args+=(-H "Content-Type: application/json" -d "$body")
  fi
  local tmp status
  tmp="$(mktemp)"
  status="$(curl "${args[@]}" -w '%{http_code}' -o "$tmp" || true)"
  if [[ ! "$status" =~ ^[0-9]+$ ]]; then
    cat "$tmp" >&2 || true
    rm -f "$tmp"
    exit 1
  fi
  if (( status >= 400 )); then
    if jq -e . >/dev/null 2>&1 <"$tmp"; then
      format_error <"$tmp" >&2
    else
      cat "$tmp" >&2
    fi
    rm -f "$tmp"
    if (( status == 401 || status == 403 )); then exit 4; fi
    exit 1
  fi
  cat "$tmp"
  rm -f "$tmp"
}

format_error() {
  jq -r 'def v($x): if $x == null or $x == "" then empty else $x end;
    "error: " + (.message // .error // "UIAI request failed"),
    (v(.error_id) | "id: " + .),
    (v(.error_class) | "class: " + .),
    (v(.status) | "status: " + tostring),
    (v(.suggested_next_action) | "next: " + .),
    (v(.diagnostics) | "diagnostics: " + .)'
}

emit() {
  case "$FORMAT" in
    json) cat ;;
    pretty) jq . ;;
    compact) compact_emit ;;
    *) err "unknown format: $FORMAT"; exit 2 ;;
  esac
}

compact_emit() {
  jq -r '
    if has("type") and .type == "status" then
      "status: " + (.services["uiai-engine"].health // "unknown") + " port=" + ((.services["uiai-engine"].port // "?")|tostring)
    elif has("status") and has("service") then
      "health: " + (.status|tostring) + " service=" + (.service|tostring)
    elif has("browser") or has("pool") or has("health") then
      "health: " + ((.status // .health // "ok")|tostring)
    elif has("events") then
      "errors: count=" + ((.count // (.events|length))|tostring) + " stored=" + ((.stored_count // "?")|tostring),
      (.events[]? | "- " + (.id // "?") + " " + (.source // "?") + ":" + (.class // "?") + " " + ((.status // "")|tostring) + " " + (.message // "") + (if .suggested_next_action then " -> " + .suggested_next_action else "" end))
    elif has("tools") then
      "tools: count=" + ((.count // (.tools|length))|tostring),
      (.tools[]? | "- " + .name + " — " + (.description // ""))
    elif has("session") then
      "session: " + (.session.id // .id // "?") + " " + (.session.url // .url // "")
    elif has("tree") or has("stats") then
      "snapshot: " + ((.stats.node_count // .stats.nodes // "?")|tostring) + " nodes", (.tree // "")
    elif has("text") then
      .text
    elif has("summary") and has("session_id") then
      "diagnostics: session=" + .session_id + " errors=" + ((.summary.console_errors // 0)|tostring) + " exceptions=" + ((.summary.exceptions // 0)|tostring) + " failed_requests=" + ((.summary.failed_requests // 0)|tostring)
    elif has("status") then
      "status: " + (.status|tostring)
    else
      .
    end'
}

urlencode() { jq -rn --arg v "$1" '$v|@uri'; }

parse_global() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) FORMAT="json"; shift ;;
      --compact) FORMAT="compact"; shift ;;
      --pretty) FORMAT="pretty"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) break ;;
    esac
  done
  CMD_ARGS=("$@")
}

cmd_errors() {
  local limit=20 source="" class=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit) limit="${2:-}"; shift 2 ;;
      --source) source="${2:-}"; shift 2 ;;
      --class) class="${2:-}"; shift 2 ;;
      *) err "unknown errors option: $1"; exit 2 ;;
    esac
  done
  local q="limit=$limit"
  [[ -n "$source" ]] && q="$q&source=$(urlencode "$source")"
  [[ -n "$class" ]] && q="$q&class=$(urlencode "$class")"
  api GET "/api/errors?$q" | emit
}

cmd_tools() {
  local sub="${1:-list}"
  case "$sub" in
    list) api GET "/api/tools/search" | emit ;;
    search) [[ $# -ge 2 ]] || { err "usage: uiai tools search <query>"; exit 2; }; api GET "/api/tools/search?q=$(urlencode "$2")" | emit ;;
    mcp) api GET "/api/tools/mcp" | emit ;;
    openai) api GET "/api/tools/openai" | emit ;;
    graph) api GET "/api/tools/graph" | emit ;;
    agent-card) api GET "/api/tools/agent-card" | emit ;;
    docs) api GET "/api/tools/docs" | emit ;;
    *) err "unknown tools subcommand: $sub"; exit 2 ;;
  esac
}

cmd_packet() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    compose)
      [[ $# -ge 1 ]] || { err "usage: uiai packet compose <json-file|->"; exit 2; }
      local body
      if [[ "$1" == "-" ]]; then
        body="$(cat)"
      else
        [[ -f "$1" ]] || { err "packet request file not found: $1"; exit 2; }
        body="$(cat "$1")"
      fi
      api POST "/api/agent/research-packet" "$body" | emit
      ;;
    *) err "usage: uiai packet compose <json-file|->"; exit 2 ;;
  esac
}

cmd_research() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    packet)
      local query="" url="" goal="UIAI research packet" out="/tmp/uiai-research-packet.json" width=1280 height=800 max_chars=2000
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --query) query="${2:-}"; shift 2 ;;
          --url) url="${2:-}"; shift 2 ;;
          --goal) goal="${2:-}"; shift 2 ;;
          --out) out="${2:-}"; shift 2 ;;
          --width) width="${2:-}"; shift 2 ;;
          --height) height="${2:-}"; shift 2 ;;
          --max-chars) max_chars="${2:-}"; shift 2 ;;
          *) err "unknown research packet option: $1"; exit 2 ;;
        esac
      done
      [[ -n "$query" || -n "$url" ]] || { err "usage: uiai research packet [--query Q|--url URL] [--goal G] [--out PATH]"; exit 2; }
      FORMAT="$FORMAT" ENGINE_URL="$ENGINE_URL" TIMEOUT_SECONDS="$TIMEOUT_SECONDS" UIAI_API_KEY="${UIAI_API_KEY:-}" UIAI_BEARER_TOKEN="${UIAI_BEARER_TOKEN:-}" \
      python3 - "$query" "$url" "$goal" "$out" "$width" "$height" "$max_chars" <<'PY'
import json, os, sys, urllib.request, urllib.error
query, url, goal, out, width, height, max_chars = sys.argv[1:8]
engine=os.environ.get('ENGINE_URL','http://localhost:7456').rstrip('/')
timeout=int(os.environ.get('TIMEOUT_SECONDS','20'))
fmt=os.environ.get('FORMAT','compact')
headers={'Content-Type':'application/json'}
if os.environ.get('UIAI_API_KEY'):
    headers['X-API-Key']=os.environ['UIAI_API_KEY']
elif os.environ.get('UIAI_BEARER_TOKEN'):
    headers['Authorization']='Bearer '+os.environ['UIAI_BEARER_TOKEN']

def req(method,path,body=None):
    data=json.dumps(body).encode() if body is not None else None
    r=urllib.request.Request(engine+path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            raw=resp.read().decode() or '{}'
            return json.loads(raw)
    except urllib.error.HTTPError as e:
        raw=e.read().decode(errors='replace')
        try: data=json.loads(raw)
        except Exception: data={'error':raw or str(e)}
        raise SystemExit(json.dumps({'ok':False,'status':e.code,'error':data}, indent=2))

responses=[]
search=None
selected_url=url
if query:
    search=req('POST','/api/search',{'query':query,'limit':1})
    responses.append(search)
    results=search.get('results') or []
    if not selected_url and results:
        selected_url=results[0].get('url') or ''
if not selected_url:
    raise SystemExit('uiai research packet: no URL supplied and search returned no selectable result')

sid=None
session_closed=False
try:
    opened=req('POST','/api/session',{'url':selected_url,'width':int(width),'height':int(height),'focusa_scope':{'project_root':'/home/wpuiai/uiai-engine','continuity_id':'focusa-cont-uiai-engine-82afe24f-90ce-4d6e-b5f2-1b431b7773fc','evidence_ref':'uiai-research-packet-cli'}})
    sid=(opened.get('session') or {}).get('id') or opened.get('id')
    if not sid: raise SystemExit(json.dumps({'ok':False,'error':'session id missing','opened':opened}, indent=2))
    read=req('POST',f'/api/session/{sid}/read',{'max_chars':int(max_chars),'include_links':True})
    snapshot=req('POST',f'/api/session/{sid}/snapshot',{'interactive':True,'compact':True})
    diagnostics=req('GET',f'/api/session/{sid}/diagnostics?limit=100')
    responses.extend([read,snapshot,diagnostics])
    packet=req('POST','/api/agent/research-packet',{
        'mode':'research' if query else 'proof',
        'goal':goal,
        'responses':responses,
        'focusa_scope':{'project_root':'/home/wpuiai/uiai-engine','continuity_id':'focusa-cont-uiai-engine-82afe24f-90ce-4d6e-b5f2-1b431b7773fc','evidence_ref':'uiai-research-packet-cli'},
        'recommended_next_action':'Capture packet evidence with Focusa, then close any remaining browser session.',
        'cleanup_session_id':sid,
    })
finally:
    if sid:
        try:
            req('DELETE',f'/api/session/{sid}')
            session_closed=True
        except Exception:
            session_closed=False

report={'ok':True,'query':query or None,'selected_url':selected_url,'session_id':sid,'session_closed':session_closed,'out':out,'packet':packet}
with open(out,'w') as f: json.dump(report,f,indent=2)
if fmt == 'json':
    print(json.dumps(report,separators=(',',':')))
elif fmt == 'pretty':
    print(json.dumps(report,indent=2))
else:
    rf=packet.get('recommended_focusa',{}) if isinstance(packet,dict) else {}
    print(f"research packet ok: out={out} url={selected_url} session_closed={session_closed} schema={packet.get('schema')} evidence_refs={len(packet.get('evidence_refs',[]))} preferred_tool={rf.get('preferred_tool')}")
PY
      ;;
    *) err "usage: uiai research packet [--query Q|--url URL] [--goal G] [--out PATH]"; exit 2 ;;
  esac
}

cmd_markdown() {
  [[ $# -ge 1 ]] || { err "usage: uiai markdown <url> [--selector S] [--max-chars N] [--mode main_content|full] [--format json|markdown|jsonl] [--include-images]"; exit 2; }
  local url="$1" selector="" max_chars=30000 mode="main_content" response_format="json" include_images=false include_links=true; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --selector) selector="${2:-}"; shift 2 ;;
      --max-chars) max_chars="${2:-}"; shift 2 ;;
      --mode) mode="${2:-}"; shift 2 ;;
      --format) response_format="${2:-}"; shift 2 ;;
      --jsonl) response_format="jsonl"; shift ;;
      --include-images) include_images=true; shift ;;
      --no-links) include_links=false; shift ;;
      *) err "unknown markdown option: $1"; exit 2 ;;
    esac
  done
  jq -cn --arg url "$url" --arg selector "$selector" --argjson max_chars "$max_chars" --arg mode "$mode" --arg format "$response_format" --argjson include_images "$include_images" --argjson include_links "$include_links" '{url:$url,max_chars:$max_chars,mode:$mode,format:$format,include_images:$include_images,include_links:$include_links} + (if $selector == "" then {} else {selector:$selector} end)' | { read -r body; api POST "/api/markdown" "$body"; } | emit
}

cmd_session() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    open)
      [[ $# -ge 1 ]] || { err "usage: uiai session open <url> [--width N] [--height N]"; exit 2; }
      local url="$1" width=1280 height=800; shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --width) width="${2:-}"; shift 2 ;;
          --height) height="${2:-}"; shift 2 ;;
          *) err "unknown session open option: $1"; exit 2 ;;
        esac
      done
      jq -cn --arg url "$url" --argjson width "$width" --argjson height "$height" '{url:$url,width:$width,height:$height}' | { read -r body; api POST "/api/session" "$body"; } | emit
      ;;
    read)
      [[ $# -ge 1 ]] || { err "usage: uiai session read <sid> [--selector S] [--max-chars N] [--format text|markdown] [--mode main_content|full]"; exit 2; }
      local sid="$1" selector="" max_chars=8000 format="text" mode="main_content" include_images=false; shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --selector) selector="${2:-}"; shift 2 ;;
          --max-chars) max_chars="${2:-}"; shift 2 ;;
          --format) format="${2:-}"; shift 2 ;;
          --mode) mode="${2:-}"; shift 2 ;;
          --include-images) include_images=true; shift ;;
          *) err "unknown session read option: $1"; exit 2 ;;
        esac
      done
      jq -cn --arg selector "$selector" --argjson max_chars "$max_chars" --arg format "$format" --arg mode "$mode" --argjson include_images "$include_images" '{max_chars:$max_chars,include_links:true,format:$format,mode:$mode,include_images:$include_images} + (if $selector == "" then {} else {selector:$selector} end)' | { read -r body; api POST "/api/session/$sid/read" "$body"; } | emit
      ;;
    snapshot) [[ $# -ge 1 ]] || { err "usage: uiai session snapshot <sid>"; exit 2; }; api POST "/api/session/$1/snapshot" '{}' | emit ;;
    diagnostics)
      [[ $# -ge 1 ]] || { err "usage: uiai session diagnostics <sid> [--limit N] [--failed-only]"; exit 2; }
      local sid="$1" limit=100 failed=""; shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --limit) limit="${2:-}"; shift 2 ;;
          --failed-only) failed="&failed_only=true"; shift ;;
          *) err "unknown diagnostics option: $1"; exit 2 ;;
        esac
      done
      api GET "/api/session/$sid/diagnostics?limit=$limit$failed" | emit
      ;;
    close) [[ $# -ge 1 ]] || { err "usage: uiai session close <sid>"; exit 2; }; api DELETE "/api/session/$1" | emit ;;
    *) err "usage: uiai session open|read|snapshot|diagnostics|close"; exit 2 ;;
  esac
}

parse_global "$@"
set -- "${CMD_ARGS[@]}"
cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
  status) api GET "/api/status" | emit ;;
  health) api GET "/api/health/browser" | emit ;;
  errors) cmd_errors "$@" ;;
  tools) cmd_tools "$@" ;;
  packet) cmd_packet "$@" ;;
  markdown) cmd_markdown "$@" ;;
  research) cmd_research "$@" ;;
  session) cmd_session "$@" ;;
  smoke)
    sub="${1:-agent}"
    case "$sub" in
      agent) exec "$ROOT_DIR/scripts/smoke-agent-integrations.sh" ;;
      browser) exec "$ROOT_DIR/scripts/stress-browser-diagnostics.sh" ;;
      packet) exec "$ROOT_DIR/scripts/smoke-focusa-packet.sh" ;;
      *) err "usage: uiai smoke agent|browser|packet"; exit 2 ;;
    esac
    ;;
  install-agent-integrations) exec "$ROOT_DIR/scripts/install-agent-integrations.sh" ;;
  -h|--help|help|"") usage ;;
  *) err "unknown command: $cmd"; usage >&2; exit 2 ;;
esac
